---
export const prerender = false;   // Dựng tại chỗ trên Cloudflare mỗi lần khách vào

import Layout from "../layouts/Layout.astro";
import LeadCTA from "../components/LeadCTA.astro";
import { GROUPS, TICKER } from "../data/commodities.mjs";
import { quyDoiVND, tienVN, giaHienThi, MIEN_TRU } from "../data/quy-doi.mjs";

// ── Lấy gia.json ngay lúc khách truy cập, giống cách trang tin tức làm.
// Nhờ vậy SỐ GIÁ nằm sẵn trong trang: Google đọc được, khách thấy ngay không
// phải chờ khung nhúng TradingView tải xong. Cloudflare không có node:fs nên
// phải dùng fetch. Thử GitHub trước (tươi nhất), lỗi thì lấy bản kèm trong build.
const NGUON_GITHUB = "https://raw.githubusercontent.com/zz761311-byte/benhanghoa/main/public/data/gia.json";
const NGUON_TAI_CHO = new URL("/data/gia.json", Astro.url).href;

// Lúc chạy thử trên máy thì đọc tập tin trên máy trước — có vậy mới xem được
// kết quả `npm run gia` vừa chạy. Trên web thật vẫn ưu tiên GitHub cho tươi.
const THU_TU_NGUON = import.meta.env.DEV
  ? [NGUON_TAI_CHO, NGUON_GITHUB]
  : [NGUON_GITHUB, NGUON_TAI_CHO];

let duLieuGia = { items: {}, capNhat: "", nguon: "", tyGia: null };
for (const url of THU_TU_NGUON) {
  try {
    const r = await fetch(url, { cache: "no-store" });
    if (r.ok) { duLieuGia = await r.json(); break; }
  } catch (e) {}
}
const bangGia = duLieuGia.items || {};

// Định dạng số theo kiểu Việt Nam: dấu chấm ngăn nghìn, dấu phẩy thập phân
function soVN(n, chuSoThapPhan) {
  if (n === null || n === undefined) return "—";
  const soLe = chuSoThapPhan ?? (Math.abs(n) >= 1000 ? 0 : Math.abs(n) >= 10 ? 2 : 3);
  return n.toLocaleString("vi-VN", { minimumFractionDigits: soLe, maximumFractionDigits: soLe });
}
const phanTram = (n) => (n === null || n === undefined ? "—" : (n > 0 ? "+" : "") + soVN(n, 2) + "%");
const huong = (n) => (n === null || n === undefined ? "" : n > 0 ? "len" : n < 0 ? "xuong" : "");

// Vẽ đường giá tí hon bằng SVG — không cần thư viện, nhẹ, hiện được cả khi
// chưa tải xong JavaScript
function duongGiaSVG(cacGia) {
  if (!cacGia || cacGia.length < 2) return null;
  const rong = 90, cao = 26, le = 2;
  const nhoNhat = Math.min(...cacGia);
  const lonNhat = Math.max(...cacGia);
  const bienDo = lonNhat - nhoNhat || 1;
  const diem = cacGia.map((g, i) => {
    const x = le + (i / (cacGia.length - 1)) * (rong - le * 2);
    const y = cao - le - ((g - nhoNhat) / bienDo) * (cao - le * 2);
    return x.toFixed(1) + "," + y.toFixed(1);
  });
  return { d: "M" + diem.join(" L"), rong, cao, tang: cacGia[cacGia.length - 1] >= cacGia[0] };
}

// Thời điểm cập nhật, hiện theo giờ Việt Nam
let thoiDiem = "";
if (duLieuGia.capNhat) {
  const d = new Date(duLieuGia.capNhat);
  if (!isNaN(d.getTime())) {
    thoiDiem = d.toLocaleString("vi-VN", {
      timeZone: "Asia/Ho_Chi_Minh", day: "2-digit", month: "2-digit", year: "numeric",
      hour: "2-digit", minute: "2-digit",
    });
  }
}
const soMatHangCoGia = Object.keys(bangGia).length;

// ── Quy đổi sang tiền Việt ────────────────────────────────────────────────
// Không lấy được tỷ giá thì ẩn hẳn cột quy đổi. Thà thiếu một cột còn hơn
// quy đổi bằng tỷ giá đoán bừa — sai tỷ giá là sai toàn bộ con số.
const tyGia = duLieuGia.tyGia?.gia || null;
const coQuyDoi = tyGia > 0;

let thoiDiemTyGia = "";
if (coQuyDoi && duLieuGia.tyGia?.capNhat) {
  const d = new Date(duLieuGia.tyGia.capNhat);
  if (!isNaN(d.getTime())) {
    thoiDiemTyGia = d.toLocaleString("vi-VN", {
      timeZone: "Asia/Ho_Chi_Minh", day: "2-digit", month: "2-digit", year: "numeric",
      hour: "2-digit", minute: "2-digit",
    });
  }
}

// Số cột bị gộp lại khi một mặt hàng tạm chưa lấy được giá
const soCotSoLieu = coQuyDoi ? 9 : 8;

// Mặt hàng chưa tìm được nguồn giá đáng tin thì KHÔNG đưa vào bảng.
// Lý do: mã TradingView của những mặt hàng này tự khớp sang thứ khác khi khách
// chưa đăng nhập, hiện ra số sai hoàn toàn (thiếc từng hiện giá cổ phiếu
// Cornish Metals 1,11 USD trong khi thiếc thật khoảng 30.000 USD/tấn).
const NHOM_HIEN = GROUPS
  .map((nhom) => ({ ...nhom, items: nhom.items.filter((mh) => !mh.chuaCoNguon) }))
  .filter((nhom) => nhom.items.length > 0);

// Danh sách bỏ ra ngoài — nêu ở cuối trang cho minh bạch, kèm đường dẫn trang chi tiết
const chuaCoNguon = GROUPS.flatMap((n) => n.items).filter((mh) => mh.chuaCoNguon);

// Cache ở biên Cloudflare 5 phút — đỡ gọi GitHub liên tục mà vẫn đủ tươi
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=300");
---
<Layout
  page="prices"
  title="Bảng giá hàng hóa thế giới hôm nay — Bến Hàng Hóa"
  description="Giá dầu thô, vàng, bạc, đồng, cà phê, ngô, đậu tương... cập nhật liên tục kèm mức thay đổi trong ngày, tuần, tháng và năm.">
  <div class="ticker-host">
    <div id="ticker" class="tradingview-widget-container"></div>
    <span class="ticker-link" aria-hidden="true"></span>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>Bảng giá hàng hóa thế giới hôm nay</h1>
      </div>

      <p class="gia-tomtat">
        {soMatHangCoGia > 0
          ? `Giá ${soMatHangCoGia} mặt hàng cập nhật lúc ${thoiDiem} (giờ Việt Nam), nguồn ${duLieuGia.nguon || "Yahoo Finance"}.`
          : "Đang cập nhật giá — vui lòng tải lại trang sau ít phút."}
        Vàng, bạc, bạch kim hiện <b>giá giao ngay</b> (kèm giá hợp đồng tương lai bên dưới).
        Các mặt hàng còn lại là <b>giá hợp đồng tương lai</b>, có ghi rõ kỳ hạn — hợp đồng
        càng xa ngày đáo hạn thì giá càng chênh so với giao ngay. Chỉ mang tính tham khảo,
        không phải khuyến nghị đầu tư.
      </p>

      {coQuyDoi && (
        <p class="gia-tygia">
          <b>Cột “Quy ra tiền Việt”</b> tính theo tỷ giá
          <b> 1 USD = {tienVN(tyGia)} đồng</b>
          {thoiDiemTyGia && <span class="nho"> (cập nhật {thoiDiemTyGia})</span>}.
          Đây là phép quy đổi thô, <b>không phải giá mua bán tại Việt Nam</b> —
          chưa gồm thuế, cước vận chuyển và chi phí chế biến.
          <a href="/quy-doi">Xem công cụ quy đổi đầy đủ →</a>
        </p>
      )}

      {NHOM_HIEN.map((nhom) => (
        <div class="gia-khoi">
          <h2 class="gia-nhom">{nhom.icon} {nhom.label}</h2>
          <div class="gia-cuon">
            <table class="gia-bang">
              <thead>
                <tr>
                  <th class="c-ten">Mặt hàng</th>
                  <th class="c-so">Giá</th>
                  {coQuyDoi && <th class="c-so c-vnd">Quy ra tiền Việt</th>}
                  <th class="c-so c-an-dt">Thay đổi</th>
                  <th class="c-so">%</th>
                  <th class="c-bd">30 phiên</th>
                  <th class="c-so c-an">Thấp/Cao ngày</th>
                  <th class="c-so c-an">1 tuần</th>
                  <th class="c-so c-an">1 tháng</th>
                  <th class="c-so c-an">1 năm</th>
                  <th class="c-bieudo">Biểu đồ</th>
                </tr>
              </thead>
              <tbody>
                {nhom.items.map((mh) => {
                  const g = bangGia[mh.slug];
                  const sp = g ? duongGiaSVG(g.duongGia) : null;
                  // Kim loại quý lấy giá giao ngay làm số chính, còn lại giữ giá
                  // hợp đồng tương lai — quy đổi tiền Việt cũng theo số này
                  const hienThi = giaHienThi(g);
                  const qd = hienThi && coQuyDoi
                    ? quyDoiVND(mh.slug, hienThi.gia, g.tienTe, tyGia)
                    : null;
                  return (
                    <tr class="gia-hang" data-symbol={mh.tv}>
                      <td class="c-ten">
                        <a href={`/hang-hoa/${mh.slug}`}>{mh.name}</a>
                        <span class="dv">{mh.unit}</span>
                      </td>
                      {g ? (
                        <>
                          <td class="c-so gia-chinh">
                            {soVN(hienThi.gia)}
                            {hienThi.laGiaoNgay ? (
                              /* Kim loại quý: nói rõ đây là giá giao ngay, rồi ghi
                                 thêm giá hợp đồng tương lai để người giao dịch
                                 phái sinh vẫn có số mình cần */
                              <>
                                <span class="gia-loai">giao ngay</span>
                                <span class="gia-hopdong">
                                  {hienThi.kyHan ? "hđ " + hienThi.kyHan : "hợp đồng"}: {soVN(hienThi.giaHopDong)}
                                </span>
                              </>
                            ) : (
                              hienThi.kyHan && <span class="gia-loai">hđ {hienThi.kyHan}</span>
                            )}
                          </td>
                          {coQuyDoi && (
                            <td class="c-so c-vnd">
                              {qd ? (
                                <>
                                  <span class="vnd-so">{tienVN(qd.gia)}</span>
                                  <span class="vnd-dv">{qd.donVi}</span>
                                  {qd.luuY.startsWith("⚠️") && (
                                    <span class="vnd-canhbao" title={qd.luuY.replace("⚠️ ", "")}>
                                      dễ nhầm — bấm tên mặt hàng để đọc kỹ
                                    </span>
                                  )}
                                </>
                              ) : "—"}
                            </td>
                          )}
                          <td class={"c-so c-an-dt " + huong(g.doi)}>{g.doi > 0 ? "+" : ""}{soVN(g.doi)}</td>
                          <td class={"c-so " + huong(g.doiPhanTram)}>{phanTram(g.doiPhanTram)}</td>
                          <td class="c-bd">
                            {sp && (
                              <svg viewBox={`0 0 ${sp.rong} ${sp.cao}`} width={sp.rong} height={sp.cao}
                                   class={"spark " + (sp.tang ? "len" : "xuong")} aria-hidden="true">
                                <path d={sp.d} fill="none" stroke="currentColor" stroke-width="1.6"
                                      stroke-linejoin="round" stroke-linecap="round" />
                              </svg>
                            )}
                          </td>
                          <td class="c-so c-an nho">{soVN(g.thapTrongNgay)} – {soVN(g.caoTrongNgay)}</td>
                          <td class={"c-so c-an " + huong(g.doiMotTuan)}>{phanTram(g.doiMotTuan)}</td>
                          <td class={"c-so c-an " + huong(g.doiMotThang)}>{phanTram(g.doiMotThang)}</td>
                          <td class={"c-so c-an " + huong(g.doiMotNam)}>{phanTram(g.doiMotNam)}</td>
                        </>
                      ) : (
                        /* Mặt hàng có mã Yahoo nhưng lượt lấy giá gần nhất bị lỗi */
                        <td class="c-chuaco" colspan={soCotSoLieu}>
                          <span class="o-gia-trong">
                            <span class="lim-badge">tạm chưa có số</span>
                            <span class="nho">lượt cập nhật gần nhất chưa lấy được giá</span>
                          </span>
                        </td>
                      )}
                      <td class="c-bieudo">
                        <button type="button" class="nut-bieudo" data-symbol={mh.tv}
                                aria-label={`Xem biểu đồ ${mh.name}`}>
                          <svg class="nut-icon" viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
                            <path d="M2.5 13.5 L7 8.5 L10.5 11.5 L17 4" fill="none" stroke="currentColor"
                                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M13 4 H17 V8" fill="none" stroke="currentColor"
                                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          <span class="nut-chu">Biểu đồ</span>
                        </button>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      <div class="chart-panel" id="khung-bieudo">
        <div class="chart-nhan" id="chart-nhan">Bấm “Xem” ở một mặt hàng để mở biểu đồ chi tiết</div>
        <div id="tv_chart"></div>
      </div>

      {coQuyDoi && (
        <div class="gia-ghichu">
          <b>Hiểu đúng cột “Quy ra tiền Việt”</b>
          <p>{MIEN_TRU}</p>
          <p>
            Hai chỗ dễ hiểu nhầm nhất:
          </p>
          <ul class="ghichu-ds">
            <li>
              <b>Vàng</b> — con số trong bảng là giá vàng <b>thế giới</b> quy đổi, không phải
              giá vàng miếng SJC hay vàng nhẫn bán trong nước. Giá trong nước lâu nay
              cao hơn một khoảng đáng kể do hạn chế nhập khẩu và độc quyền thương hiệu.
            </li>
            <li>
              <b>Cà phê</b> — bảng này yết cà phê <b>Arabica</b> (sàn New York), trong khi
              Tây Nguyên chủ yếu trồng <b>Robusta</b> (sàn London). Hai loại khác nhau,
              giá cũng khác nhau. Đừng lấy số này tính giá cà phê nhân xô.
            </li>
            <li>
              <b>Giá giao ngay khác giá hợp đồng tương lai.</b> Hợp đồng tương lai là
              cam kết mua bán vào một tháng trong tương lai, nên giá đã cộng sẵn chi phí
              lưu kho và lãi suất từ nay đến lúc đó — càng xa ngày đáo hạn càng chênh
              nhiều. Ví dụ hợp đồng vàng tháng 12 thường cao hơn giá giao ngay khoảng
              1–2%. Vàng, bạc, bạch kim trong bảng lấy giá giao ngay để khớp với con số
              bạn tra được ở nơi khác; các mặt hàng còn lại giữ giá hợp đồng vì đó mới
              là chuẩn của thị trường và của sàn giao dịch.
            </li>
          </ul>
          <p>
            Muốn tính thành tiền theo số lượng cụ thể, dùng
            <a href="/quy-doi"> công cụ quy đổi</a> — nhập số kg, số lít, số lượng vàng
            là ra ngay thành tiền.
          </p>
        </div>
      )}

      {chuaCoNguon.length > 0 && (
        <div class="gia-ghichu">
          <b>Vì sao bảng này không có {chuaCoNguon.map((mh) => mh.name).join(", ")}?</b>
          <p>
            Những mặt hàng đó giao dịch trên các sàn LME, ICE châu Âu, Thượng Hải và
            Singapore. Dữ liệu giá của các sàn này có bản quyền, không có nguồn miễn phí
            công khai nào đủ tin cậy. Chúng tôi đã thử và phát hiện các nguồn miễn phí
            trả về <b>giá của mặt hàng khác</b> — nên quyết định để trống thay vì đưa bạn
            một con số sai.
          </p>
          <p>
            Cần giá những mặt hàng này, vui lòng
            <a href="#dang-ky">liên hệ để được tư vấn</a>. Trang giới thiệu từng mặt hàng
            vẫn còn: {chuaCoNguon.map((mh, i) => (
              <>
                {i > 0 && ", "}
                <a href={`/hang-hoa/${mh.slug}`}>{mh.name}</a>
              </>
            ))}.
          </p>
        </div>
      )}
    </div>
  </section>

  <div class="container" id="dang-ky" style="scroll-margin-top:84px">
    <LeadCTA item="hàng hóa" />
  </div>
</Layout>

<script is:inline src="https://s3.tradingview.com/tv.js"></script>
<script define:vars={{ TICKER }}>
  // Thanh giá chạy
  const tickerHost = document.getElementById("ticker");
  if (tickerHost) {
    const s = document.createElement("script");
    s.async = true;
    s.src = "https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js";
    s.innerHTML = JSON.stringify({
      symbols: TICKER, showSymbolLogo: true, isTransparent: true,
      displayMode: "adaptive", colorTheme: "dark", locale: "vi_VN"
    });
    tickerHost.appendChild(s);
  }

  // Biểu đồ chi tiết — chỉ tải khi khách bấm, không tải sẵn cho nhẹ trang
  const oChart = document.getElementById("tv_chart");
  const nhanChart = document.getElementById("chart-nhan");
  const khungChart = document.getElementById("khung-bieudo");
  function moBieuDo(maTV, tenMatHang) {
    if (!oChart) return;
    oChart.innerHTML = "";
    if (nhanChart) nhanChart.textContent = "Biểu đồ: " + tenMatHang;
    new TradingView.widget({
      autosize: true, symbol: maTV, interval: "D", timezone: "Asia/Ho_Chi_Minh",
      theme: "dark", style: "1", locale: "vi_VN", toolbar_bg: "#0e2138",
      enable_publishing: false, hide_side_toolbar: false,
      allow_symbol_change: true, container_id: "tv_chart"
    });
    // Đưa biểu đồ lên giữa màn hình. Trừ chiều cao đầu trang dính (khoảng 70px)
    // để biểu đồ không bị thanh menu che mất phần trên.
    if (khungChart) {
      const CAO_DAU_TRANG = 76;
      const oViTri = khungChart.getBoundingClientRect();
      const chua = window.innerHeight - CAO_DAU_TRANG;
      // Biểu đồ thấp hơn màn hình thì căn giữa; cao hơn thì đưa mép trên lên đầu
      const chenhLech = oViTri.height < chua
        ? (chua - oViTri.height) / 2
        : 0;
      const diToi = window.scrollY + oViTri.top - CAO_DAU_TRANG - chenhLech;
      window.scrollTo({ top: Math.max(0, diToi), behavior: "smooth" });
    }
  }

  document.querySelectorAll(".nut-bieudo").forEach((nut) => {
    nut.addEventListener("click", () => {
      const hang = nut.closest(".gia-hang");
      const ten = hang?.querySelector(".c-ten a")?.textContent || "";
      document.querySelectorAll(".gia-hang.dang-xem").forEach((h) => h.classList.remove("dang-xem"));
      hang?.classList.add("dang-xem");
      moBieuDo(nut.dataset.symbol, ten);
    });
  });

  // Vào thẳng bằng đường dẫn có ?symbol=... thì mở luôn biểu đồ đó
  const maMuonXem = new URLSearchParams(location.search).get("symbol");
  if (maMuonXem) {
    const nut = document.querySelector('.nut-bieudo[data-symbol="' + (window.CSS ? CSS.escape(maMuonXem) : maMuonXem) + '"]');
    if (nut) nut.click();
  }
</script>

<style>
  .gia-tomtat {
    color: var(--muted); font-size: 14px; line-height: 1.65;
    margin: 0 0 12px; max-width: 900px;
  }
  /* Dòng nêu tỷ giá đang dùng — phải nổi hơn chữ thường vì mọi con số quy đổi
     trong bảng đều phụ thuộc vào nó */
  .gia-tygia {
    color: var(--muted); font-size: 13.5px; line-height: 1.7;
    margin: 0 0 22px; max-width: 900px;
    padding: 10px 14px; border-left: 3px solid var(--accent);
    background: rgba(217, 164, 65, 0.06); border-radius: 0 8px 8px 0;
  }
  .gia-tygia b { color: var(--text); }
  .gia-tygia .nho { font-size: 12.5px; }
  .gia-tygia a { margin-left: 4px; white-space: nowrap; }
  .gia-khoi { margin-bottom: 26px; }
  .gia-nhom {
    font-size: 17px; margin: 0 0 10px; padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  /* Bảng rộng hơn màn hình điện thoại thì cho cuộn ngang trong khung riêng,
