---
import Layout from "../../layouts/Layout.astro";
import LeadCTA from "../../components/LeadCTA.astro";
import { ALL } from "../../data/commodities.mjs";
import { DETAILS } from "../../data/details.mjs";
import { QUY_DOI } from "../../data/quy-doi.mjs";

export function getStaticPaths() {
  return ALL.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const d = DETAILS[item.slug] || null;

// Bảng hệ số quy đổi sang tiền Việt (nếu mặt hàng này có).
// Trang chi tiết là trang TĨNH — nhúng thẳng con số vào lúc dựng thì giá sẽ
// đóng băng mãi, vì Cloudflare không dựng lại web mỗi lượt bot ghi giá. Nên
// chỉ gửi sang phần hệ số (không đổi), còn giá và tỷ giá thì tải lúc khách mở.
const bangQuyDoi = QUY_DOI[item.slug] || null;

const title = `Giá ${item.name} hôm nay — biểu đồ & thông số hợp đồng | Bến Hàng Hóa`;
const description = `Cập nhật giá ${item.name} real-time, biểu đồ chi tiết, thông số hợp đồng giao dịch và các yếu tố ảnh hưởng giá. ${d ? d.intro.slice(0, 90) : ""}`;

// FAQ schema cho SEO
const faqSchema = d && d.faq ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": d.faq.map((f) => ({
    "@type": "Question", "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
} : null;
---
<Layout page="prices" title={title} description={description}>
  <section class="section">
    <div class="container detail-wrap">
      <nav class="breadcrumb">
        <a href="/">Trang chủ</a> › <a href="/bang-gia">Bảng giá</a> › <span>{item.name}</span>
      </nav>

      <h1>Giá {item.name} hôm nay {item.limited && <span class="lim-badge">dữ liệu hạn chế</span>}</h1>

      <!-- Hộp giá real-time. Bọc thêm lớp chặn bấm: khung này chỉ để xem số,
           không cần bấm vào đâu — chặn để khách không lỡ tay nhảy sang TradingView. -->
      <div class="detail-quote-boc">
        <div id="symbol-info" class="tradingview-widget-container detail-quote"></div>
        <span class="detail-quote-chan" aria-hidden="true"></span>
      </div>

      <!-- Quy ra tiền Việt. Khối này ẩn sẵn, chỉ hiện khi tải được giá và tỷ giá.
           Không có dữ liệu thì thà không hiện còn hơn hiện số đoán. -->
      {bangQuyDoi && (
        <div class="qd-hop" id="qd-hop" hidden>
          <div class="qd-hop-dau">
            <span class="qd-hop-nhan">Quy ra tiền Việt</span>
            <span class="qd-hop-thoi" id="qd-thoi"></span>
          </div>
          <div class="qd-hop-so" id="qd-so">—</div>
          <div class="qd-hop-phu" id="qd-phu"></div>
          <div class="qd-hop-luuy" id="qd-luuy"></div>
          <a class="qd-hop-link" href="/quy-doi">Tính thành tiền theo số lượng →</a>
        </div>
      )}

      <!-- Biểu đồ lớn -->
      <div class="detail-chart"><div id="adv-chart" class="tradingview-widget-container"></div></div>

      <!-- Thông số hợp đồng -->
      <h2>Thông số hợp đồng</h2>
      {d && d.mxv ? (
        <table class="spec-table">
          <tbody>
            <tr><th>Mã hợp đồng (tham khảo)</th><td>{d.mxv.ma}</td></tr>
            <tr><th>Sở giao dịch gốc</th><td>{d.mxv.san}</td></tr>
            <tr><th>Đơn vị yết giá</th><td>{d.mxv.donVi}</td></tr>
            <tr><th>Độ lớn hợp đồng</th><td>{d.mxv.doLon}</td></tr>
            <tr><th>Bước giá tối thiểu</th><td>{d.mxv.buocGia}</td></tr>
            <tr><th>Tháng đáo hạn</th><td>{d.mxv.thang}</td></tr>
            <tr><th>Giờ giao dịch</th><td>{d.mxv.gio}</td></tr>
            <tr><th>Mức ký quỹ</th><td>Liên hệ tư vấn (thay đổi theo thị trường)</td></tr>
          </tbody>
        </table>
      ) : (
        <p class="spec-note">{d ? d.mxvNote : "Thông số hợp đồng đang được cập nhật. Vui lòng liên hệ để được tư vấn chi tiết."}</p>
      )}
      {d && d.mxv && (
        <p class="spec-disclaimer">⚠️ Thông số mang tính tham khảo — vui lòng xác nhận với bộ phận tư vấn/MXV trước khi giao dịch.</p>
      )}

      <!-- Giới thiệu + yếu tố ảnh hưởng -->
      {d && (
        <>
          <h2>Về {item.name}</h2>
          <p class="detail-intro">{d.intro}</p>
          {d.drivers && (
            <>
              <h3>Yếu tố ảnh hưởng đến giá</h3>
              <ul class="driver-list">
                {d.drivers.map((x) => <li>{x}</li>)}
              </ul>
            </>
          )}
        </>
      )}

      <!-- Thu lead -->
      <LeadCTA item={item.name} />

      <!-- FAQ -->
      {d && d.faq && (
        <>
          <h2>Câu hỏi thường gặp</h2>
          <div class="faq">
            {d.faq.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </>
      )}

      <p class="back-link"><a href="/bang-gia">← Quay lại bảng giá đầy đủ</a> · <a href="/tin-tuc">Tin tức liên quan →</a></p>
    </div>
  </section>

  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</Layout>

<style>
  .detail-wrap { max-width: 880px; }
  .breadcrumb { font-size: 13.5px; color: var(--muted); margin-bottom: 10px; }
  .breadcrumb a { color: var(--muted); }
  .breadcrumb a:hover { color: var(--accent); }
  .detail-wrap h1 { font-size: clamp(24px, 3.4vw, 34px); margin: 0 0 16px; }
  .detail-wrap h2 { font-size: 21px; margin: 28px 0 12px; }
  .detail-wrap h3 { font-size: 17px; margin: 18px 0 8px; }
  .detail-quote { min-height: 220px; margin-bottom: 12px; }
  /* Khung giá chỉ để đọc số — lớp chặn phủ kín để khách không bấm trúng logo
     TradingView rồi bị đưa sang trang của họ */
  .detail-quote-boc { position: relative; }
  .detail-quote-chan { position: absolute; inset: 0; z-index: 3; display: block; }
  .detail-chart { height: 460px; background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius); padding: 8px; }
  .detail-chart .tradingview-widget-container, .detail-chart #adv-chart { height: 100% !important; }
  .spec-table { width: 100%; border-collapse: collapse; background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .spec-table th, .spec-table td { padding: 11px 16px; text-align: left; border-bottom: 1px solid var(--line); font-size: 15px; }
  .spec-table th { color: var(--muted); font-weight: 600; width: 42%; }
  .spec-table tr:last-child td, .spec-table tr:last-child th { border-bottom: 0; }
  .spec-note, .spec-disclaimer { color: var(--muted); font-size: 14px; }
  .spec-disclaimer { color: #e3c172; margin-top: 8px; }
  .detail-intro { color: var(--text); font-size: 16px; line-height: 1.7; }
  .driver-list { color: var(--muted); line-height: 1.9; }
  .driver-list li { margin-bottom: 4px; }
  .faq-item { background: var(--bg-2); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; margin-bottom: 10px; }
  .faq-item summary { cursor: pointer; font-weight: 600; color: var(--text); }
  .faq-item p { color: var(--muted); margin: 10px 0 0; }
  .back-link { margin-top: 26px; font-size: 14.5px; }

  /* ── Khối quy ra tiền Việt ── */
  .qd-hop {
    background: var(--bg-2); border: 1px solid var(--line);
    border-left: 3px solid var(--accent); border-radius: var(--radius);
    padding: 14px 18px 16px; margin-bottom: 14px;
  }
  .qd-hop-dau {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 12px; flex-wrap: wrap;
  }
  .qd-hop-nhan {
    font-size: 11.5px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px;
    font-weight: 600;
  }
  .qd-hop-thoi { font-size: 11.5px; color: var(--muted); }
  .qd-hop-so {
    font-size: clamp(21px, 3.6vw, 27px); font-weight: 800; color: var(--accent);
    font-variant-numeric: tabular-nums; line-height: 1.25; margin-top: 3px;
  }
  .qd-hop-phu { font-size: 13px; color: var(--muted); margin-top: 4px; line-height: 1.6; }
  .qd-hop-luuy {
    font-size: 12.5px; color: var(--muted); line-height: 1.7; margin-top: 10px;
    padding-top: 10px; border-top: 1px solid var(--line);
  }
  /* Mặt hàng dễ hiểu nhầm (vàng thế giới ≠ vàng SJC, Arabica ≠ Robusta) */
  .qd-hop-luuy.manh { color: #e3c172; }
  .qd-hop-link { display: inline-block; margin-top: 9px; font-size: 13px; }
</style>

<script define:vars={{ sym: item.tv }}>
  // Mặt hàng chưa tìm được nguồn giá đáng tin (xem ghi chú trong commodities.mjs)
  // thì KHÔNG nạp khung nào — nạp với mã rỗng thì TradingView tự khớp sang mã
  // trùng tên và hiện giá của thứ khác hoàn toàn.
  if (!sym) {
    for (const id of ["symbol-info", "adv-chart"]) {
      const o = document.getElementById(id);
      if (o) {
        o.innerHTML =
          '<p style="color:var(--muted);font-size:14px;padding:18px 0;margin:0">' +
          "Mặt hàng này chưa có nguồn dữ liệu giá đáng tin cậy dùng được miễn phí. " +
          "Chúng tôi để trống thay vì hiển thị số liệu có thể sai. " +
          "Cần thông tin, vui lòng liên hệ để được tư vấn." +
          "</p>";
        o.closest(".detail-chart")?.style.setProperty("height", "auto");
      }
    }
  } else {
  // Hộp thông tin giá
  const info = document.getElementById("symbol-info");
  if (info) {
    const s = document.createElement("script");
    s.async = true;
    s.src = "https://s3.tradingview.com/external-embedding/embed-widget-symbol-info.js";
    s.innerHTML = JSON.stringify({
      symbol: sym, width: "100%", locale: "vi_VN", colorTheme: "dark", isTransparent: true
    });
    info.appendChild(s);
  }
  // Biểu đồ lớn
  const chart = document.getElementById("adv-chart");
  if (chart) {
    const s = document.createElement("script");
    s.async = true;
    s.src = "https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js";
    s.innerHTML = JSON.stringify({
      symbol: sym, autosize: true, interval: "D", timezone: "Asia/Ho_Chi_Minh",
      theme: "dark", style: "1", locale: "vi_VN", hide_side_toolbar: false,
      allow_symbol_change: false, calendar: false
    });
    chart.appendChild(s);
  }
  }
</script>

<script define:vars={{ slug: item.slug, bangQuyDoi, donViSan: item.unit }}>
  // ── Quy giá mặt hàng này ra tiền Việt ─────────────────────────────────────
  // Chạy phía khách vì trang chi tiết là trang tĩnh: nhúng số lúc dựng thì giá
  // sẽ đứng yên mãi. Lấy bản trên GitHub trước cho tươi nhất, hỏng thì lấy bản
  // kèm theo lượt dựng — bản đó cũ hơn nhưng vẫn ghi rõ thời điểm cho khách biết.
  if (bangQuyDoi) {
    const NGUON = [
      "https://raw.githubusercontent.com/zz761311-byte/benhanghoa/main/public/data/gia.json",
      "/data/gia.json",
    ];

    const tienVN = (so) => {
      const soLe = Math.abs(so) < 1000 ? 1 : 0;
      return so.toLocaleString("vi-VN", { minimumFractionDigits: soLe, maximumFractionDigits: soLe });
    };

    (async () => {
      let duLieu = null;
      for (const url of NGUON) {
        try {
          const r = await fetch(url, { cache: "no-store" });
          if (r.ok) { duLieu = await r.json(); break; }
        } catch (e) {}
      }
      const g = duLieu?.items?.[slug];
      const tyGia = duLieu?.tyGia?.gia;
      // Thiếu giá hoặc thiếu tỷ giá thì để khối ẩn nguyên — không hiện số nửa vời
      if (!g || !(g.gia > 0) || !(tyGia > 0)) return;

      // Vàng, bạc, bạch kim quy đổi theo GIÁ GIAO NGAY — đó mới là con số ai tra
      // "giá vàng thế giới" cũng thấy. Hợp đồng tương lai tháng xa cao hơn giao
      // ngay 1-2% vì cộng chi phí lưu kho và lãi suất, quy ra tiền Việt là lệch
      // cả triệu đồng một lượng.
      const coGiaoNgay = g.giaoNgay?.gia > 0;
      const giaDung = coGiaoNgay ? g.giaoNgay.gia : g.gia;
      const kyHan = g.kyHan || null;   // bot ghi sẵn, ví dụ "T12/26"

      // Yahoo yết vài mặt hàng bằng cents (mã tiền tệ "USX"), phải chia 100 trước
      const giaUSD = g.tienTe === "USX" ? giaDung / 100 : giaDung;
      const dongMoiDonViSan = giaUSD * tyGia;
      const giaChinh = dongMoiDonViSan / bangQuyDoi.heSo;

      document.getElementById("qd-so").textContent =
        tienVN(giaChinh) + " " + bangQuyDoi.donViVN;

      const phanPhu = [];
      if (bangQuyDoi.phu) {
        phanPhu.push(
          "≈ " + tienVN(dongMoiDonViSan / bangQuyDoi.phu.heSo) + " " + bangQuyDoi.phu.donViVN
        );
      }
      phanPhu.push(
        "Từ " + giaDung.toLocaleString("vi-VN", { maximumFractionDigits: 4 }) + " " + donViSan +
        (coGiaoNgay ? " (giá giao ngay)" : kyHan ? " (hợp đồng " + kyHan + ")" : "") +
        ", tỷ giá 1 USD = " + tyGia.toLocaleString("vi-VN") + " đồng"
      );
      // Kim loại quý: ghi thêm giá hợp đồng tương lai để người giao dịch phái
      // sinh vẫn thấy con số mình cần, và hiểu vì sao hai số lệch nhau
      if (coGiaoNgay) {
        const lech = g.giaoNgay.lechSoVoiHopDong;
        // Hợp đồng có thể cao hơn hoặc thấp hơn giao ngay — phải nói đúng chiều,
        // không thể viết "cao hơn -0,04%"
        const soSanh = lech == null ? "" :
          " (" + (lech >= 0 ? "cao hơn" : "thấp hơn") + " giao ngay " +
          Math.abs(lech).toLocaleString("vi-VN") + "%)";
        phanPhu.push(
          "Hợp đồng tương lai" + (kyHan ? " " + kyHan : "") + ": " +
          g.gia.toLocaleString("vi-VN", { maximumFractionDigits: 4 }) + " " + donViSan + soSanh
        );
      }
      phanPhu.push(bangQuyDoi.giaiThich);
      document.getElementById("qd-phu").textContent = phanPhu.join("  ·  ");

      const oLuuY = document.getElementById("qd-luuy");
      oLuuY.textContent = bangQuyDoi.luuY;
      oLuuY.classList.toggle("manh", bangQuyDoi.luuY.startsWith("⚠️"));

      // Thời điểm của số giá đang dùng — bắt buộc hiện, để khách biết số cũ hay mới
      const luc = new Date(g.capNhat || duLieu.capNhat);
      if (!isNaN(luc.getTime())) {
        document.getElementById("qd-thoi").textContent =
          "giá lúc " + luc.toLocaleString("vi-VN", {
            timeZone: "Asia/Ho_Chi_Minh", day: "2-digit", month: "2-digit",
            hour: "2-digit", minute: "2-digit",
          });
      }

      document.getElementById("qd-hop").hidden = false;
    })();
  }
</script>
